# ─────────────────────────────────────────────────────────────────────────────
# Offer Wall Crawler — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file and rename it to .env
#   2. Fill in your credentials for each publisher you want to crawl
#   3. Leave unused publishers empty — the crawler will skip them automatically
# ─────────────────────────────────────────────────────────────────────────────


# ── TesterUP ──────────────────────────────────────────────────────────────────
# Required — used for both the crawler (run.py) and the dashboard (app.py)
TESTERUP_EMAIL=your@email.com
TESTERUP_PASSWORD=yourpassword
TESTERUP_COUNTRY=US


# ── Kashkick ──────────────────────────────────────────────────────────────────
# Required: email + password (direct login, may be blocked by Turnstile CAPTCHA)
# Optional: session cookie captured from browser if login is blocked
KASHKICK_EMAIL=your@email.com
KASHKICK_PASSWORD=yourpassword
# KASHKICK_SESSION_COOKIE=   # paste full Cookie header value from browser DevTools


# ── Freecash ──────────────────────────────────────────────────────────────────
# Freecash does not have a public API. Set a session cookie after logging in
# manually, OR provide email/password for when direct login is implemented.
# See freecash_crawler.py for full setup instructions.
FREECASH_EMAIL=your@email.com
FREECASH_PASSWORD=yourpassword
# FREECASH_SESSION_COOKIE=   # paste full Cookie header value from browser DevTools


# ── Swagbucks ─────────────────────────────────────────────────────────────────
# Swagbucks does not have a public API. Set a session cookie, or use the
# AdGate Media publisher API (see swagbucks_crawler.py for instructions).
SWAGBUCKS_EMAIL=your@email.com
SWAGBUCKS_PASSWORD=yourpassword
# SWAGBUCKS_SESSION_COOKIE=  # paste full Cookie header value from browser DevTools
# ADGATE_AFFILIATE_ID=       # AdGate publisher affiliate ID (Option B)
# ADGATE_API_KEY=            # AdGate publisher API key (Option B)
